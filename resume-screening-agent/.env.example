# Set only the API key(s) for the provider(s) you actually use.

# Embeddings (stage 1, cheap/local by default — only needed if embedding.provider: openai)
OPENAI_API_KEY=

# LLM scoring (stage 2) — set the key matching config.yaml's llm.provider:
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here          # provider: openai (shares the key above)
ANTHROPIC_API_KEY=
LLM_API_KEY=                                        # provider: openai_compatible (Groq/Together/Ollama/etc.)

# Optional: require an X-API-Key header from callers (e.g. the Spring MVC webapp).
# Leave blank for no-auth (default).
RECRUITMENT_API_KEY=change-me
